{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/advisor",
      "dest": "/api/advisor.ts"
    },
    {
      "src": "/api/analyze",
      "dest": "/api/analyze.ts"
    },
    {
      "src": "/api/insights",
      "dest": "/api/analyze.ts"
    },
    {
      "src": "/api/send-report",
      "dest": "/api/send-report.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
